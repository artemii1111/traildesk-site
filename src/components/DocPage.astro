---
import { render } from 'astro:content';
import { docsFor } from '../docs';
import { REPO } from '../consts';
import { href } from '../nav';

interface Props { t: any; slug: string }
const { t, slug } = Astro.props;
const docs = await docsFor(t.lang);
const i = docs.findIndex((d) => d.slug === slug);
const doc = docs[i];
const { Content } = await render(doc);
const prev = docs[i - 1], next = docs[i + 1];
---
<section class="sub doc">
  <nav class="doc-nav" aria-label={t.doc.contents}>
    <a class="doc-up" href={href(t.lang, 'docs')}>{t.pages.docs.title}</a>
    <ul>{docs.map((d) => <li><a href={href(t.lang, 'docs', d.slug)} aria-current={d.slug === slug ? 'page' : undefined}>{d.data.title}</a></li>)}</ul>
  </nav>
  <article class="prose" lang={doc.data.translated ? t.lang : 'en'}>
    {!doc.data.translated && <p class="doc-note">{t.doc.fallback}</p>}
    <h1>{doc.data.title}</h1>
    <Content />
    <p class="doc-pager">
      {prev ? <a href={href(t.lang, 'docs', prev.slug)}>← {prev.data.title}</a> : <span></span>}
      {next && <a href={href(t.lang, 'docs', next.slug)}>{next.data.title} →</a>}
    </p>
    <p class="doc-edit"><a href={`${REPO}/blob/main/${doc.data.source}`}>{t.doc.edit} ↗</a></p>
  </article>
</section>

